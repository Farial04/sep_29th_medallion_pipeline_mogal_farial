# Select the provider used by the pipeline: anthropic, groq, gemini, openai, or github.
# Anthropic is the recommended default; configure the matching API key below.
LLM_PROVIDER=anthropic

# Get an Anthropic API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Pinned snapshot keeps model behavior and cost stable. If this ID is retired, check
# https://docs.claude.com/en/docs/about-claude/models and update it deliberately.
# Other options: claude-sonnet-5 (higher cost, more reasoning), claude-opus-5 (highest cost).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: get a Groq API key at https://console.groq.com/keys
GROQ_API_KEY=
# Alternative: openai/gpt-oss-120b
# Alternative: llama-3.3-70b-versatile
# Groq may retire preview or instant model IDs; for model_not_found, check
# https://console.groq.com/docs/models
# gpt-oss models are reasoning models; callers must suppress reasoning for JSON parsing.
GROQ_MODEL=openai/gpt-oss-20b

# Optional: get a Google Gemini API key at https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Optional: get an OpenAI API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: create a GitHub token at https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini
